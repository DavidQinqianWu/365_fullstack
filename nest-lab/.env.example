# nest-lab 的环境变量样例。复制成 .env 再改:cp .env.example .env
# .env 已在 .gitignore 里,不要提交真实的 .env(里面会有密钥)。
# 规则和默认值的唯一来源是 src/config/env.schema.ts

# development | test | production
NODE_ENV=development
# 端口,必须是 0–65535 的整数
PORT=3000
# 演示用的钥匙(请求头 x-demo-key)。至少 8 个字符;production 下不能用默认值 let-me-in
DEMO_KEY=let-me-in
# 是否打印进出门日志:true / false
LOG_REQUESTS=true
# 是否开放 Swagger UI(/docs)与 OpenAPI JSON(/docs-json):true / false;不写时生产环境关闭、其他环境打开
# SWAGGER_ENABLED=true

# ---------- Day 22:本地 PostgreSQL(compose.yaml 和 npm run day22–day26 读这几项) ----------
# 只在本机开发用;docker compose 第一次初始化数据卷时用它们建用户和库
POSTGRES_USER=nest_lab
POSTGRES_PASSWORD=nest_lab_dev
POSTGRES_DB=nest_lab
# 本机端口。本机已经装了别的 PostgreSQL 占着 5432 时,改成 5433 之类
POSTGRES_PORT=5432

# ---------- Day 27:任务数据存在哪 ----------
# memory(默认):内存仓储,不需要数据库;postgres:存进 PostgreSQL(先 npm run db:reset 建表)
TASKS_STORAGE=memory
# TASKS_STORAGE=postgres 时必填。用户名 / 密码 / 端口 / 库名和上面的 POSTGRES_* 保持一致
DATABASE_URL=postgresql://nest_lab:nest_lab_dev@localhost:5432/nest_lab
# 表放在哪个 schema(只允许小写字母、数字、下划线)
DATABASE_SCHEMA=app
# 连接池最多几个连接。多副本部署时:副本数 × DB_POOL_MAX 不能超过数据库的 max_connections(默认 100)
DB_POOL_MAX=10
# 启动时清空任务表并写入样品数据(只给测试 / 观察脚本用;生产环境禁止)
DB_RESET_ON_START=false
