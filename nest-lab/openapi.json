            "description": "请求格式错误(JSON 语法错、路径参数不是整数、cursor 无效)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "404": {
            "description": "资源不存在",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "406": {
            "description": "无法提供 Accept 要求的格式",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          }
        },
        "summary": "查看一个用户",
        "tags": [
          "users"
        ]
      }
    }
  },
  "info": {
    "title": "nest-lab 任务管理 API",
    "description": "365 计划 Week 3 的任务管理 REST API。\n\n- 设计约定:`docs/api-design.md`(语言无关)\n- 错误格式:RFC 9457 `application/problem+json`,错误类型目录见 `docs/problems.md`\n- 版本:`/v2/...` 为当前版本,不带版本号的路径等同 v2;`/v1/...` 已弃用,计划 2027-05-01 下线",
    "version": "2.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "demo-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-demo-key",
        "description": "演示用的钥匙,开发环境默认 let-me-in"
      }
    },
    "schemas": {
      "ProblemDetailsDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "错误类别的 URI,程序判断请看它。目录见 docs/problems.md",
            "example": "https://nest-lab.example/problems/not-found"
          },
          "title": {
            "type": "string",
            "description": "同一类别永远相同的简短标题",
            "example": "资源不存在"
          },
          "status": {
            "type": "number",
            "description": "HTTP 状态码,与响应行一致",
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "这一次具体发生了什么(给人看的)",
            "example": "没有 id 为 999 的任务"
          },
          "instance": {
            "type": "string",
            "description": "这一次出错的请求路径",
            "example": "/v2/tasks/999"
          },
          "requestId": {
            "type": "string",
            "description": "扩展字段:请求 ID,与响应头 x-request-id 相同;报错时请附上",
            "example": "7c1e2f0a-…"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "requestId"
        ]
      },
      "FieldErrorDto": {
        "type": "object",
        "properties": {
          "pointer": {
            "type": "string",
            "description": "JSON Pointer(RFC 6901),指向出错的字段;查询参数也用这个写法",
            "example": "#/checklist/1/text"
          },
          "detail": {
            "type": "string",
            "example": "text 不能为空或全是空白"
          }
        },
        "required": [
          "pointer",
          "detail"
        ]
      },
      "ValidationProblemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "错误类别的 URI,程序判断请看它。目录见 docs/problems.md",
            "example": "https://nest-lab.example/problems/not-found"
          },
          "title": {
            "type": "string",
            "description": "同一类别永远相同的简短标题",
            "example": "资源不存在"
          },
          "status": {
            "type": "number",
            "description": "HTTP 状态码,与响应行一致",
            "example": 404
          },
          "detail": {
            "type": "string",
            "description": "这一次具体发生了什么(给人看的)",
            "example": "没有 id 为 999 的任务"
          },
          "instance": {
            "type": "string",
            "description": "这一次出错的请求路径",
            "example": "/v2/tasks/999"
          },
          "requestId": {
            "type": "string",
            "description": "扩展字段:请求 ID,与响应头 x-request-id 相同;报错时请附上",
            "example": "7c1e2f0a-…"
          },
          "errors": {
            "description": "字段级错误列表(type 为 validation-error 时)",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldErrorDto"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "requestId"
        ]
      },
      "ChecklistItemResponse": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "example": "买菜"
          },
          "done": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "text",
          "done"
        ]
      },
      "TaskResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "学 OpenAPI"
          },
          "done": {
            "type": "boolean",
            "example": false
          },
          "checklist": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemResponse"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "title",
          "done",
          "checklist",
          "createdAt"
        ]
      },
      "TaskPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "下一页的 cursor;null 表示已经是最后一页。不透明,原样传回 ?cursor=",
            "example": "eyJ2IjoxLCJzIjoiaWQiLCJmIjp7fSwiayI6WzIwXSwiaWQiOjIwfQ"
          }
        },
        "required": [
          "items",
          "nextCursor"
        ]
      },
      "ChecklistItemDto": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 100,
            "example": "买菜"
          },
          "done": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "text",
          "done"
        ]
      },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "标题,首尾空格会被去掉,不能全是空白",
            "maxLength": 100,
            "example": "学 OpenAPI"
          },
          "checklist": {
            "maxItems": 20,
            "description": "PUT 时不给 = 清空为 []",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        },
        "required": [
          "title"
        ]
      },
      "ReplaceTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "标题,首尾空格会被去掉,不能全是空白",
            "maxLength": 100,
            "example": "学 OpenAPI"
          },
          "done": {
            "type": "boolean",
            "description": "是否已完成",
            "example": false
          },
          "checklist": {
            "maxItems": 20,
            "description": "PUT 时不给 = 清空为 []",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        },
        "required": [
          "title",
          "done"
        ]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "标题,首尾空格会被去掉,不能全是空白",
            "maxLength": 100,
            "example": "学 OpenAPI"
          },
          "done": {
            "type": "boolean",
            "description": "是否已完成",
            "example": false
          },
          "checklist": {
            "maxItems": 20,
            "description": "PUT 时不给 = 清空为 []",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChecklistItemDto"
            }
          }
        }
      },
      "TaskListV1Envelope": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponse"
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "timestamp"
        ]
      },
      "TaskV1Envelope": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/TaskResponse"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "data",
          "timestamp"
        ]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1
          },
          "email": {
            "type": "string",
            "description": "非管理员视图会打码,如 a***@example.com",
            "example": "a***@example.com"
          },
          "displayName": {
            "type": "string",
            "example": "Alice"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "internalNote": {
            "type": "string",
            "description": "内部备注,只有管理员视图(x-demo-role: admin)才有"
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role",
          "createdAt"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "会被去掉首尾空格并转成小写",
            "example": "carol@example.com"
          },
          "displayName": {
            "type": "string",
            "maxLength": 50,
            "example": "Carol"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "description": "明文密码,只进不出(服务器存 scrypt 哈希)",
            "example": "carol-secret-1"
          },
          "role": {
            "type": "string",
            "enum": [
              "user",
              "admin"
            ],
            "default": "user"
          }
        },
        "required": [
          "email",
          "displayName",
          "password"
        ]
      }
    }
  }
