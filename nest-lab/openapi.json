    "/v2/tasks": {
      "get": {
        "operationId": "Tasks_findAll_v2",
        "parameters": [
          {
            "name": "x-request-id",
            "in": "header",
            "description": "可选的请求 ID;不带则由服务器生成,响应头里原样返回",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "done",
            "required": false,
            "in": "query",
            "description": "只看已完成 / 未完成;只接受 true 或 false",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "标题包含这个关键字(不区分大小写)",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "sort",
            "required": false,
            "in": "query",
            "description": "逗号分隔,前缀 - 表示倒序,最多 3 个;可选字段:id -id createdAt -createdAt title -title。默认按 id 升序,总会追加 id 作为唯一排序键",
            "schema": {
              "example": "-createdAt,title",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "超过上限回 422,不会悄悄截断",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "上一页响应里的 nextCursor,原样传回;不要解析或拼接。坏了或排序 / 过滤条件变了回 400 invalid-cursor",
            "schema": {
              "maxLength": 500,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskPage"
                }
              }
            }
          },
          "400": {
            "description": "请求格式错误(JSON 语法错、路径参数不是整数、cursor 无效)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "406": {
            "description": "无法提供 Accept 要求的格式",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsDto"
                }
              }
            }
          },
          "422": {
            "description": "请求内容未通过校验,见 errors",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDto"
                }
              }
            }
          }
        },
        "summary": "列出任务(cursor 分页、过滤、排序)",
        "tags": [
          "tasks"
        ]
      },
      "post": {
        "description": "不幂等:同一个请求发两次会建两条。成功时 Location 头指向新资源。",
